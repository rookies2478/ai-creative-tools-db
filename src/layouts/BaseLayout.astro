---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: string;
  noindex?: boolean;
  homePage?: boolean;
}

const {
  title,
  description = '生成AI画像・動画ツールを商用利用・料金・著作権で比較',
  canonicalPath,
  ogType = 'website',
  jsonLd,
  noindex = false,
  homePage = false,
} = Astro.props;

const canonicalUrl = canonicalPath && Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="impact-site-verification" value="41943675-e53a-4a3e-842e-e216852614dd">
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Design-token fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="AIクリエイティブナビ" />
    <meta property="og:image" content="https://aicreative-db.com/ogp.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AIクリエイティブナビ",
      "alternateName": "AI画像・動画生成DB",
      "url": "https://aicreative-db.com/",
      "description": "AI画像生成・AI動画生成ツールを、生成サンプル・プロンプト・商用利用・無料枠・透かし・日本語対応などの観点で比較するサイト",
      "publisher": {
        "@type": "Organization",
        "name": "AIクリエイティブナビ運営者",
        "url": "https://aicreative-db.com/about/"
      }
    })} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script>
      import { shouldInitializeMeasurement, minimizeDestinationUrl } from '../utils/measurementSafety.mjs';

      const runtimeWindow = window as any;

      // Only the exact canonical production hostname may initialize GA4/Clarity.
      // Cloudflare Pages previews are production builds too, so build mode alone
      // is intentionally not sufficient.
      if (shouldInitializeMeasurement(window.location.hostname, import.meta.env.PROD)) {
        runtimeWindow.dataLayer = runtimeWindow.dataLayer || [];
        runtimeWindow.gtag = function () {
          runtimeWindow.dataLayer.push(arguments);
        };
        runtimeWindow.gtag('js', new Date());
        runtimeWindow.gtag('config', 'G-YTH7GM5ZGT');

        const gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-YTH7GM5ZGT';
        document.head.appendChild(gtagScript);

        runtimeWindow.clarity = runtimeWindow.clarity || function () {
          (runtimeWindow.clarity.q = runtimeWindow.clarity.q || []).push(arguments);
        };
        const clarityScript = document.createElement('script');
        clarityScript.async = true;
        clarityScript.src = 'https://www.clarity.ms/tag/wo9noh1ex6';
        document.head.appendChild(clarityScript);
      }

      // Outbound CTA click tracking (official_site_click / affiliate_click).
      // Navigation behavior is untouched; only the analytics destination value
      // is minimized to origin + pathname (query/hash are never sent).
      document.addEventListener('click', function (event) {
        if (!(event.target instanceof Element)) return;
        const el = event.target.closest('[data-outbound-type]');
        if (!el) return;
        if (typeof runtimeWindow.gtag !== 'function') return;

        const outboundType = el.getAttribute('data-outbound-type');
        const eventName = outboundType === 'affiliate' ? 'affiliate_click' : 'official_site_click';
        const destinationUrl = minimizeDestinationUrl(
          el.getAttribute('href') || '',
          window.location.href
        );

        runtimeWindow.gtag('event', eventName, {
          tool_name: el.getAttribute('data-tool-name') || '',
          cta_position: el.getAttribute('data-cta-position') || '',
          destination_url: destinationUrl,
          page_path: window.location.pathname
        });
      });
    </script>
  </head>
  <body class:list={['min-h-screen text-slate-900 antialiased', homePage ? 'body-paper' : 'bg-white']}>

    <!-- ===== HEADER ===== -->
    <header class="nv-topbar">
      <div class="nv-inner">
        <a href="/" class="nv-logo" aria-label="AIクリエイティブナビ トップページ">
          <span class="nv-mark" aria-hidden="true">AI</span>
          <span class="nv-wordmark">
            <span class="nv-name">クリエイティブナビ</span>
          </span>
        </a>

        <nav class="nv-nav">
          <a href="/categories/video-generation/">AI動画生成</a>
          <a href="/categories/image-generation/">AI画像生成</a>
          <a href="/comparisons/">比較表</a>
          <a href="/guides/commercial-use-copyright/">商用利用ガイド</a>
        </nav>

        <a href="/tools/" class="nv-mobile-top-cta">ツールを探す</a>

        <div class="nv-actions">
          <a href="/tools/" class="nv-cta">ツールを探す <span class="nv-arr">→</span></a>

          <details class="nv-mobile-details">
            <summary class="nv-menu" aria-label="メニューを開く">
              <svg class="nv-icon-menu" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <line x1="3" y1="6" x2="19" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="3" y1="11" x2="19" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="3" y1="16" x2="19" y2="16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="nv-mobile-panel">
              <a href="/tools/" class="nv-mobile-cta">ツールを探す →</a>
              <nav class="nv-mobile-nav" aria-label="モバイルメニュー">
                <a href="/categories/video-generation/">AI動画生成</a>
                <a href="/categories/image-generation/">AI画像生成</a>
                <a href="/comparisons/">比較表</a>
                <a href="/guides/commercial-use-copyright/">商用利用ガイド</a>
                <div class="nv-mobile-divider"></div>
                <a href="/conditions/free/">無料で試せる</a>
                <a href="/conditions/commercial-use/">商用利用を確認</a>
                <a href="/conditions/japanese/">日本語対応</a>
                <a href="/conditions/no-watermark/">透かしなし</a>
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="nf-footer">
      <div class="nf-inner">

        <div class="nf-grid">
          <!-- About -->
          <div class="nf-about">
            <a href="/" class="nv-logo nf-logo-light" aria-label="AIクリエイティブナビ トップページ">
              <span class="nv-mark" aria-hidden="true">AI</span>
              <span class="nv-wordmark">
                <span class="nv-name">クリエイティブナビ</span>
              </span>
            </a>
            <p class="nf-desc">AI動画生成・AI画像生成を中心に、料金・無料枠・商用利用条件・日本語対応などを比較するAIクリエイティブツール比較メディアです。</p>
          </div>

          <!-- カテゴリ -->
          <div class="nf-col">
            <h4>Categories</h4>
            <ul>
              <li><a href="/categories/image-generation/">AI画像生成ツール</a></li>
              <li><a href="/categories/video-generation/">AI動画生成ツール</a></li>
              <li><a href="/categories/video-editing/">AI動画編集ツール</a></li>