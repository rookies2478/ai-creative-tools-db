---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConditionChips from '../../../components/ConditionChips.astro';
import ComparisonFootnote from '../../../components/ComparisonFootnote.astro';
import Free, { type FreePlan } from '../../../components/Free.astro';
import { videoFreeDownloadStatus, type HandsOnStatus } from '../../../data/videoFreeDownloadStatus';

const entries = await getCollection('tools');

const handsOnLabel = (s: HandsOnStatus) => {
  if (s === 'confirmed') return { ch: '○', cls: 'yes', label: '確認済み' };
  if (s === 'failed') return { ch: '×', cls: 'no', label: '不可を確認' };
  if (s === 'not-applicable') return { ch: '－', cls: 'na', label: '対象外' };
  if (s === 'not-confirmed') return { ch: '!', cls: 'cond', label: '要検証' };
  return { ch: '?', cls: 'cond', label: '未確認' };
};

const planTypeLabel: Record<string, string> = {
  'ongoing-free-plan': '恒常的な無料プラン',
  'free-trial': 'Free Trial（期間・回数限定）',
  'limited-free-access': '無料枠あり（回数・クレジット制限）',
  'paid-only': '有料のみ',
  'service-unavailable': 'サービス対象外',
  unknown: '要確認',
};

const videoFreeRows = videoFreeDownloadStatus.map((s) => {
  const entry = entries.find((e) => e.slug === s.sourceToolSlug);
  return {
    ...s,
    name: entry?.data.name ?? s.sourceToolSlug,
  };
});
const tools = entries
  .filter((e) => e.data.freePlan === true || e.data.freePlan === 'limited')
  .map((e) => {
    const cu = e.data.commercialUse;
    const commercial =
      cu === 'ok' ? '公式案内あり' :
      cu === 'paid-only' ? '有料プラン向け' :
      cu === 'limited' ? '条件あり' :
      cu === 'no' ? '非対応' :
      '要確認';
    const jaUi = e.data.japaneseUi;
    const jaPrompt = e.data.japanesePrompt;
    const ja =
      jaUi === true ? '対応' :
      jaUi === false && jaPrompt === false ? '非対応' :
      (jaUi === 'partial' || jaPrompt === true || jaPrompt === 'partial') ? '部分対応' :
      '要確認';
    const wm = e.data.watermark;
    const watermark =
      wm === 'no' ? 'なし' :
      wm === 'yes' ? 'あり' :
      wm === 'limited' ? 'プランによる' :
      '要確認';
    return {
      name: e.data.name,
      slug: e.slug,
      initial: e.data.name.charAt(0),
      freePlan: (e.data.freePlan === true ? 'あり' : 'limited') as FreePlan,
      ja,
      commercial,
      watermark,
      verifiedAt: e.data.verifiedAt ?? '',
    };
  });

const customFaqs = [
  {
    q: '「無料プランあり」と「完全無料」はどう違いますか？',
    a: '「無料プランあり」は有料プランも存在しつつ、無料で使える枠が用意されているツールを指します。生成回数・クレジット数・機能に上限がある場合がほとんどです。「完全無料」はすべての機能を無制限に無料で使えるという意味合いで使われることがありますが、AIクリエイティブツールで完全無料と言えるものはごく限られています。本ページで掲載しているのは「無料枠がある」ツールであり、無料での利用範囲は各ツールの公式サイトでご確認ください。',
  },
  {
    q: 'スマホで無料で使えるAI動画生成ツールはありますか？',
    a: 'iOS・Androidアプリやモバイルブラウザに対応しているとされるAI動画生成ツールはありますが、スマホからすべての機能を利用できるかどうかはツールやプランによって異なります。また、スマホ対応の有無や対応の範囲は変更される場合があります。利用時点の公式情報をご確認ください。AI動画生成ツールの一覧は<a href="/categories/video-generation/">AI動画生成カテゴリ</a>で確認できます。',
  },
  {
    q: '登録なし・ログイン不要で使えるAI生成ツールはありますか？',
    a: 'ツールの中にはアカウント登録なしで試せるとされているものもありますが、登録不要・ログイン不要かどうかはツールの仕様変更によって変わる場合があります。本ページでは登録不要かどうかを保証できないため、利用時点の公式サイトでご確認ください。',
  },
  {
    q: '画像から動画を無料で作れるAIツールはありますか？',
    a: '画像→動画（image-to-video）に対応しているとされるAIツール（Runway・Pika・Kling AI・Luma AI・Haiperなど）には無料枠が用意されている場合があります。ただし無料枠内での利用可能な生成回数・動画尺・透かし条件はツールごとに異なります。最新の無料枠条件は各公式サイトでご確認ください。image-to-videoの選び方は<a href="/categories/video-generation/">AI動画生成ツール比較</a>もご参照ください。',
  },
  {
    q: 'AI画像生成を無料で使う場合の注意点は何ですか？',
    a: '①生成回数・クレジット上限の確認、②透かしの有無（無料プランでは透かしが付くツールが多い）、③商用利用条件の確認（無料プランでは商用利用が制限される場合がある）、④画像解像度・出力サイズが有料プランより制限される場合があることを確認しておくことをおすすめします。GeminiやChatGPT系の画像生成も検討する場合は、<a href="/tools/gemini-image-generation/">Gemini画像生成の特徴</a>もあわせて確認してください。<a href="/conditions/no-watermark/">透かしなしで使いやすいツール</a>・<a href="/guides/ai-image-commercial-use-checklist/">AI画像の商用利用チェックリスト</a>もご参照ください。本記事は法的助言ではありません。',
  },
  {
    q: '無料プランでも日本語プロンプトは使えますか？',
    a: '日本語プロンプトに対応しているとされるツールは無料プランでも日本語入力が使える場合があります。ただし日本語UIへの対応と日本語プロンプトへの対応は別問題です。また細かい画風や映像スタイルの指定では英語プロンプトの方が意図を伝えやすい場合があります。日本語対応状況は<a href="/conditions/japanese/">日本語対応ツール</a>のページでも確認できます。',
  },
  {
    q: '無料プランで生成した画像や動画は商用利用できますか？',
    a: '無料プランでの商用利用の可否はツールによって異なります。無料プランで商用利用が案内されているツールがある一方、無料プランでは非商用のみに限定されているツールも多くあります。また無料プランでは透かしが付く場合があり、商用成果物として使いにくいケースもあります。LoRAやモデル共有に強い<a href="/tools/tensor-art/">Tensor.Art</a>のように、無料枠の範囲が異なるツールもあります。商用利用前は必ず最新の公式利用規約をご確認ください。本記事は法的助言ではありません。<a href="/guides/commercial-use-copyright/">商用利用・著作権の考え方ガイド</a>もご参照ください。',
  },
];

const customRelated = [
  { label: 'AI画像生成ツール一覧', href: '/categories/image-generation/' },
  { label: 'AI動画生成ツール一覧', href: '/categories/video-generation/' },
  { label: 'AI動画編集ツール一覧', href: '/categories/video-editing/' },
  { label: 'AIアバター動画ツール一覧', href: '/categories/avatar-video/' },
  { label: '無料AI画像生成ツール比較', href: '/comparisons/free-ai-image-generators/' },
  { label: '無料で試せるAI画像生成の作例比較', href: '/comparisons/free-ai-image-generation-samples/' },
  { label: 'AI動画生成ツールの作例比較', href: '/comparisons/ai-video-generation-sample-comparison/' },
  { label: 'YouTube向けツール', href: '/use-cases/youtube/' },
  { label: 'Shorts向けツール', href: '/use-cases/shorts/' },
  { label: '顔出しなし動画向けツール', href: '/use-cases/faceless-video/' },
];

const customRelatedSolid = [
  { label: '商用利用条件を確認しやすいツール', href: '/conditions/commercial-use/' },
  { label: '透かしなしで使えるツール', href: '/conditions/no-watermark/' },
  { label: '日本語対応ツール', href: '/conditions/japanese/' },
  { label: '商用利用・著作権の考え方ガイド', href: '/guides/commercial-use-copyright/' },
  { label: 'AI画像の商用利用チェックリスト', href: '/guides/ai-image-commercial-use-checklist/' },
  { label: 'AI生成ツールのクレジット制ガイド', href: '/guides/ai-generation-credits-guide/' },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: customFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
  })),
};

const breadcrumbSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://aicreative-db.com/' },
    { '@type': 'ListItem', position: 2, name: '無料で使えるAIツール', item: 'https://aicreative-db.com/conditions/free/' },
  ],
};

const combinedSchema = JSON.stringify([faqSchemaObj, breadcrumbSchemaObj]);
---

<BaseLayout
  title="無料で使えるAI動画生成・AI画像生成ツール比較｜無料枠・スマホ対応・透かし・商用利用条件を確認"
  description="無料枠のあるAI画像生成・AI動画生成ツールを、商用利用条件・透かし・日本語対応・確認日とあわせて比較します。無料範囲や制限は変更される場合があるため、最新情報は公式サイトをご確認ください。本記事は法的助言ではありません。"
  canonicalPath="/conditions/free/"
  jsonLd={combinedSchema}
>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <nav class="mb-6 text-sm text-slate-500" aria-label="パンくずリスト">
      <a href="/" class="hover:underline">トップ</a>
      <span class="mx-1">/</span>
      <span>無料で使えるAIツール</span>
    </nav>
    <ConditionChips currentPath="/conditions/free/" />

    <div class="my-6 rounded-xl border border-slate-100 bg-slate-50 px-5 py-4 text-sm">
      <p class="mb-3 text-xs font-semibold text-slate-500 tracking-wide uppercase">凡例 — 表の読み方</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-slate-600">
        <span><span class="inline-block w-5 text-center font-bold text-emerald-600">○</span> 対応あり / なし（透かし）/ 案内あり（商用）</span>
        <span><span class="inline-block w-5 text-center font-bold text-amber-600">△</span> 部分対応 / 条件あり / プランによる</span>
        <span><span class="inline-block w-5 text-center font-bold text-rose-600">×</span> 非対応 / あり（透かし）/ 不可（商用）</span>
        <span><span class="inline-block w-5 text-center font-bold text-slate-400">－</span> 非掲載 / 確認中</span>
        <span><span class="inline-block w-5 text-center font-bold text-orange-500">!</span> 要注意（条件付き・要公式確認）</span>
      </div>
      <p class="mt-3 text-xs text-slate-400">各欄の条件はプランや時期により変更される場合があります。実務利用前に必ず各ツールの公式サイトをご確認ください。</p>
    </div>

    <Free
      {tools}
      headingHtml='無料で試せる<span class="hl">AI動画生成・AI画像生成</span>ツール'
      lead="無料プランがあるAI動画生成・AI画像生成・AI動画編集・AIアバター動画ツールの条件をまとめています。スマホ対応・透かしの有無・商用利用条件・生成回数の上限は、ツールやプランによって大きく異なります。「無料プランあり」と「完全無料」は異なる概念です。登録不要・ログイン不要かどうかも含め、実務利用前に必ず各公式サイトの最新情報をご確認ください。本ページは法的助言ではありません。"
      faqs={customFaqs}
      related={customRelated}
      relatedSolid={customRelatedSolid}
    />

    <section class="vfd-sec">
      <h2 class="vfd-h2">動画生成AIの無料生成・無料ダウンロード実機確認</h2>
      <p class="vfd-note">
        動画生成AI13ツールについて、無料での生成可否と無料での動画ダウンロード可否を分けて確認した結果です。「無料で作れる」と「無料で保存できる」は別問題であるため、この2点を分離して掲載しています。Free Trial（期間・回数限定）と恒常的な無料プランも区別しています。「要検証」はリポジトリ内に十分な根拠がなく断定していない項目、「対象外」はサービス自体が一般利用者向けに提供されていない状態を示します。
      </p>
      <div class="vfd-table-wrap">
        <table class="vfd-table">
          <thead>
            <tr>
              <th>ツール</th>
              <th>無料プラン種別</th>
              <th>無料生成</th>
              <th>無料ダウンロード</th>
              <th>カード登録</th>
              <th>透かし</th>
              <th>確認日</th>
              <th>詳細</th>
            </tr>
          </thead>
          <tbody>
            {videoFreeRows.map((r) => {
              const gen = handsOnLabel(r.freeGeneration);
              const dl = handsOnLabel(r.freeDownload);
              const card = r.cardRequired === 'yes' ? '必要' : r.cardRequired === 'no' ? '不要' : '要確認';
              return (
                <tr>
                  <td class="vfd-name">{r.name}</td>
                  <td class="vfd-plan">{planTypeLabel[r.planType] ?? '要確認'}</td>
                  <td><span class={`vfd-mk ${gen.cls}`} title={gen.label}>{gen.ch}</span></td>
                  <td><span class={`vfd-mk ${dl.cls}`} title={dl.label}>{dl.ch}</span></td>
                  <td class="vfd-note-cell">{card}</td>
                  <td class="vfd-note-cell">{r.watermark}</td>
                  <td class="vfd-note-cell">{r.verifiedAt ?? '－'}</td>
                  <td><a class="vfd-link" href={r.detailUrl}>詳細 →</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="vfd-legend">○：確認済み　×：不可を確認　!：要検証　－：対象外</p>
      <ComparisonFootnote />
    </section>
  </div>
</BaseLayout>

<style>
  .vfd-sec { max-width: 1024px; margin: 0 auto; padding: 0 24px 64px; }
  .vfd-h2 { font-size: clamp(19px, 2.4vw, 24px); font-weight: 800; color: #111827; margin-bottom: 12px; }
  .vfd-note { font-size: 13px; color: #6B7280; line-height: 1.75; margin-bottom: 18px; max-width: 760px; }
  .vfd-table-wrap { overflow-x: auto; border: 1px solid #E5E7EB; border-radius: 12px; }
  .vfd-table { width: 100%; min-width: 820px; border-collapse: collapse; font-size: 12.5px; }
  .vfd-table thead tr { background: #F9FAFB; }
  .vfd-table th { text-align: left; padding: 11px 13px; font-size: 11.5px; font-weight: 700; color: #374151; border-bottom: 1px solid #E5E7EB; white-space: nowrap; }
  .vfd-table td { padding: 10px 13px; border-bottom: 1px solid #E5E7EB; color: #374151; vertical-align: top; }
  .vfd-table tr:last-child td { border-bottom: none; }
  .vfd-name { font-weight: 600; color: #111827; white-space: nowrap; }
  .vfd-plan { font-size: 11.5px; color: #6B7280; white-space: nowrap; }
  .vfd-note-cell { font-size: 11px; color: #6B7280; }
  .vfd-mk { display: inline-flex; width: 22px; height: 22px; border-radius: 50%; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
  .vfd-mk.yes { background: #E6F3EC; color: #1E8A4C; }
  .vfd-mk.no { background: #F8EFD9; color: #A06A09; }
  .vfd-mk.cond { background: #F8EFD9; color: #A06A09; }
  .vfd-mk.na { background: #EFEFEA; color: #6A7180; }
  .vfd-link { color: #2E25A6; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .vfd-link:hover { text-decoration: underline; }
  .vfd-legend { margin-top: 10px; font-size: 11.5px; color: #9CA3AF; }
</style>
