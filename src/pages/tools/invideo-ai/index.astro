---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDetailPage from '../../../components/ToolDetailPage.astro';
import { resolveToolOutboundLink } from '../../../utils/resolveToolOutboundLink';

const tools = await getCollection('tools');
const entry = tools.find((t) => t.slug === 'invideo-ai');
const d = entry?.data;

const outboundLink = resolveToolOutboundLink({ toolSlug: 'invideo-ai', officialUrl: 'https://invideo.io' });
const pricingOutboundLink = resolveToolOutboundLink({
  toolSlug: 'invideo-ai',
  officialUrl: 'https://invideo.io/pricing/',
  placement: 'pricing',
});

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://aicreative-db.com/' },
      { '@type': 'ListItem', position: 2, name: 'ツール一覧', item: 'https://aicreative-db.com/tools/' },
      { '@type': 'ListItem', position: 3, name: 'InVideo AI', item: 'https://aicreative-db.com/tools/invideo-ai/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'InVideo AI',
    operatingSystem: 'Web',
    applicationCategory: 'VideoApplication',
    description: 'InVideo AIは、AIエージェントが脚本・絵コンテ・映像生成・編集までを対話的に進めるエージェント型のAI動画制作プラットフォーム。複数の生成AIモデルとエディタを利用でき、クレジット制・席数課金。生成物の利用条件と素材ライセンスは分けて確認が必要。',
    url: 'https://invideo.io',
  },
]);
