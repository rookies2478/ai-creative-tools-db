---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDetailPage from '../../../components/ToolDetailPage.astro';
import { generatedVideos } from '../../../data/generatedVideos';
import { buildNextReads, buildConditionTags } from '../../../data/toolRelatedLinks';

const tools = await getCollection('tools');
const entry = tools.find((t) => t.slug === 'kling-ai');
const d = entry?.data;

const klingAiSampleVideo = generatedVideos.find(
  (v) => v.pageSlug === 'kling-ai' && v.sampleType === 'tool-video-output' && v.isSameToolAsPage
) ?? null;

const klingAiVideoObjectSource =
  klingAiSampleVideo &&
  klingAiSampleVideo.file === '/videos/generated/tools/kling-ai-tool-video-output-01.mp4' &&
  klingAiSampleVideo.poster === '/videos/generated/tools/kling-ai-tool-video-output-01-poster.webp'
    ? klingAiSampleVideo
    : null;

const jsonLdEntries = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://aicreative-db.com/' },
      { '@type': 'ListItem', position: 2, name: 'ツール一覧', item: 'https://aicreative-db.com/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Kling AI', item: 'https://aicreative-db.com/tools/kling-ai/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Kling AI',
    operatingSystem: 'Web',
    applicationCategory: 'VideoApplication',
    description: 'Kling AIは中国Kuaishou系が開発したAI動画生成ツール（運営法人はシンガポール法人とされる）。テキスト・画像から最大10秒の動画を生成でき、動画延長（最大3分）にも対応。無料プランは付与量は要会員画面確認付与。',
    url: 'https://kling.ai',
  },
];

if (klingAiVideoObjectSource) {
  jsonLdEntries.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Kling AI実例動画｜Kling AI 2.0',
    description: klingAiVideoObjectSource.usageNote,
    thumbnailUrl: ['https://aicreative-db.com/videos/generated/tools/kling-ai-tool-video-output-01-poster.webp'],
    uploadDate: '2026-06-24',
    duration: 'PT5S',
    contentUrl: 'https://aicreative-db.com/videos/generated/tools/kling-ai-tool-video-output-01.mp4',
    width: 1280,
    height: 720,
  });
}

const jsonLd = JSON.stringify(jsonLdEntries);
