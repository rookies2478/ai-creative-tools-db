---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDetailPage from '../../../components/ToolDetailPage.astro';
import { generatedVideos } from '../../../data/generatedVideos';
import { buildNextReads, buildConditionTags } from '../../../data/toolRelatedLinks';

const tools = await getCollection('tools');
const entry = tools.find((t) => t.slug === 'luma-ai');
const d = entry?.data;

const lumaSampleVideo = generatedVideos.find(
  (v) => v.pageSlug === 'luma-ai' && v.sampleType === 'tool-video-output' && v.isSameToolAsPage
) ?? null;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://aicreative-db.com/' },
      { '@type': 'ListItem', position: 2, name: 'ツール一覧', item: 'https://aicreative-db.com/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Luma AI', item: 'https://aicreative-db.com/tools/luma-ai/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Luma AI',
    operatingSystem: 'Web, API',
    applicationCategory: 'VideoApplication',
    description: 'Luma AIはLuma AppとAPIを提供するAIクリエイティブ基盤。現行動画モデルRay3.2でテキスト・画像からの動画生成、編集、リフレーム、複数キーフレームなどに対応。',
    url: 'https://lumalabs.ai/',
  },
]);
---

<BaseLayout
  title="Luma AI（Ray3.2）とは？料金・トライアル・商用利用の確認点"
  description="Luma AIの現行Ray3.2、Plus・Pro・Ultra・Enterpriseのプラン構成、free trial credits、API料金、商用利用・透かしの確認ポイントを公式情報に基づき整理します。"
  canonicalPath="/tools/luma-ai/"
  ogType="article"
  jsonLd={jsonLd}
>

  <nav class="tdp-bc" aria-label="パンくずリスト">
    <div class="wrap">
      <a href="/">トップ</a>
      <span class="sep">/</span>
      <a href="/tools/">ツール一覧</a>
      <span class="sep">/</span>
      <span class="cur">Luma AI</span>
    </div>
  </nav>

  <div class="tdp-wrap">
    <ToolDetailPage japanBilling={d?.japanBilling}
      toolName="Luma AI"
      category="AI動画生成"
      checkedDate={d?.lastReviewed ?? '2026-11-05'}
      headingHtml='Luma AI（Ray3.2）の<span class="hl"><span class="phrase-nowrap">料金</span>・トライアル・商用利用</span>まとめ'
      lead="Luma AIは、クリエイター向けLuma Appと開発者向けAPIを提供するAIクリエイティブ基盤です。現行動画モデルはRay3.2で、テキスト・画像からの動画生成、動画編集、リフレーム、複数キーフレームなどに対応します。旧Dream MachineやRay2を現行モデルとして扱わないよう公式情報で明記されています。AppとAPIでは料金・無料枠・商用利用条件が異なるため、このページでは現行公式情報を分けて整理します。"
      specs={[
        { lb: '商用利用', badge: { s: 'cond', label: 'App/APIで条件確認' } },
        { lb: '無料枠', badge: { s: 'cond', label: 'free trial credits' } },
        { lb: '料金目安', text: 'Plus〜（現行金額は要公式確認）', mono: true },
        { lb: '透かし', badge: { s: 'cond', label: 'APIなし / App要確認' } },
        { lb: '日本語UI', badge: { s: 'na', label: '要確認' } },
        { lb: '入力素材', badge: { s: 'cond', label: '注意あり' } },
      ]}
      primaryCta={{ label: '公式サイトで確認する', href: 'https://lumalabs.ai/' }}
      secondaryCta={{ label: '料金プランを確認（公式）', href: 'https://lumalabs.ai/pricing' }}
      basicInfo={[
        {
          title: '商用利用', badge: { s: 'cond', label: 'App/APIで条件確認' }, wide: true,
          sum: 'Luma APIの公式FAQではAPI出力の商用利用が認められています。Luma Appの現行プラン別条件は最新規約・契約画面で確認が必要です。',
          det: 'Trial出力は公式利用規約上、内部評価・テスト目的に限定されています。API出力は公式FAQで商用利用可と案内されていますが、Luma Appのプラン別権利条件を旧Dream Machineの条件から引き継いで断定しないでください。利用経路ごとに最新規約を確認してください。',
        },
        {
          title: '無料枠', badge: { s: 'cond', label: 'free trial credits' },
          det: '現行公式情報ではPlus・Pro・Ultra・Enterpriseの各プランにfree trial creditsが案内されています。恒常的なFreeプランは確認できません。APIには無料枠がなく、最初の生成から従量課金です。',
        },
        {
          title: '料金', sum: 'Plus / Pro / Ultra / Enterprise（現行金額は要公式確認）', sumMono: false,
