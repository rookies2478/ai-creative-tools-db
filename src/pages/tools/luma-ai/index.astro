        { title: '主な機能', wide: true, feats: ['Ray3.2動画生成（5秒/10秒）', 'Modify Video V2（最大20秒・1080p）', 'リフレーム', '複数キーフレーム', 'HDR / 16-bit EXR', 'API'] },
      ]}
      useCases={[
        '<b>Ray3.2で短尺動画を生成</b>したい場合（新規生成は5秒/10秒）',
        '<b>既存動画を最大20秒・1080pで編集</b>したい場合（Modify Video V2）',
