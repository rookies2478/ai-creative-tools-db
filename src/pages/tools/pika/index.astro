---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDetailPage from '../../../components/ToolDetailPage.astro';
import { generatedVideos } from '../../../data/generatedVideos';
import { buildNextReads, buildConditionTags } from '../../../data/toolRelatedLinks';

const tools = await getCollection('tools');
const entry = tools.find((t) => t.slug === 'pika');
const d = entry?.data;

const pikaSampleVideo = generatedVideos.find(
  (v) =>
    v.pageSlug === 'pika' &&
    v.sampleType === 'tool-video-output' &&
    v.isSameToolAsPage
) ?? null;

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: 'https://aicreative-db.com/' },
      { '@type': 'ListItem', position: 2, name: 'ツール一覧', item: 'https://aicreative-db.com/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Pika', item: 'https://aicreative-db.com/tools/pika/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pika',
    operatingSystem: 'Web',
    applicationCategory: 'VideoApplication',
    description: 'Pikaの新料金比較ではFreeの商用ライセンスなし、Creator/Fancyにはあり。Starterは公式説明に差があります。',
    url: 'https://pika.art',
  },
]);
---

<BaseLayout
  title="Pikaの料金・商用利用・無料枠を比較｜AIクリエイティブナビ"
  description="Pikaの料金・Freeの月額付与0と商用ライセンス条件、Starterの公式説明の差異、透かし・日本語対応を整理。"
  canonicalPath="/tools/pika/"
  ogType="article"
  jsonLd={jsonLd}
>

  <nav class="tdp-bc" aria-label="パンくずリスト">
    <div class="wrap">
      <a href="/">トップ</a>
      <span class="sep">/</span>
      <a href="/tools/">ツール一覧</a>
      <span class="sep">/</span>
      <span class="cur">Pika</span>
    </div>
  </nav>

  <div class="tdp-wrap">
    <ToolDetailPage japanBilling={d?.japanBilling}
      sampleVideo={pikaSampleVideo}
      toolName="Pika"
      category="AI動画生成"
      checkedDate={d?.lastReviewed ?? '2026-06-05'}
      headingHtml='Pikaの<span class="hl"><span class="phrase-nowrap">商用利用</span>・料金・無料枠</span>まとめ'
      lead="Pikaはテキストや画像から動画を生成できるAI動画生成ツールです。通常動画やPikaframesなど複数の生成機能に対応しています。無料枠・クレジット数・透かし・商用利用条件はプランや時期によって変わる場合があるため、最新条件は公式サイトをご確認ください。"
