        { lb: '商用利用', badge: { s: 'cond', label: '新Freeは商用ライセンスなし' } },
        { lb: '無料枠', badge: { s: 'cond', label: '新Freeは月額付与0・パック購入可' } },
        { lb: '料金目安', text: '$8/月〜（年払い）', mono: true },
        { lb: '透かし', badge: { s: 'cond', label: '公式料金表では無料も透かしなし' } },
        { lb: '日本語UI', badge: { s: 'cond', label: '部分対応' } },
        { lb: '入力素材', badge: { s: 'cond', label: '注意あり' } },
